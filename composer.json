{
    "name": "agile1tech/saiqe-evaluation",
    "description": "SAIQE two-arm evaluation harness. System under test: FCCSMS.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "infection/infection": "^0.29",
        "phpstan/phpstan": "^2.1",
        "cyclonedx/cyclonedx-php-composer": "^5.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Saiqe\\Harness\\": "harness/src/"
        },
        "classmap": [
            "sut/app/core",
            "sut/app/models",
            "sut/app/ai",
            "sut/core"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "cyclonedx/cyclonedx-php-composer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "arm-a": "php harness/bin/run_arm.php A",
        "arm-b": "php harness/bin/run_arm.php B"
    }
}
